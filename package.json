{
  "name": "equation-catcher",
  "version": "0.1.0",
  "description": "Vibe Coding Challenge capstone: a browser game where you catch the number that solves the equation",
  "type": "module",
  "scripts": {
    "start": "node serve.mjs",
    "test": "node --test tests/game.test.mjs tests/coach.test.mjs",
    "test:tap": "node --test --test-reporter=tap --test-reporter-destination=tests/results/unit-latest.tap tests/game.test.mjs tests/coach.test.mjs",
    "dashboard": "node scripts/build-dashboard.mjs",
    "test:e2e": "node tests/e2e-browser.mjs",
    "train": "node scripts/train-coach.mjs",
    "submission": "node scripts/build-submission.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
